  <diagram id="309Dh7bBKian-HSWfBpV" name="Page-8">
    <mxGraphModel dx="1030" dy="562" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n\ntitle Sequence Diagram - Vani Tuition Centre System\n\nautonumber\n\nactor Admin\nactor Teacher\nactor Student\nactor Parent\n\nparticipant \&quot;Vani Tuition Centre System\&quot; as System\nparticipant \&quot;QR Attendance System\&quot; as QR\nparticipant \&quot;AI Chatbot System\&quot; as AI\ndatabase Database\n\n== Student Management ==\n\nAdmin -&gt; System : Manage Student Records\nactivate System\n\nSystem -&gt; Database : Add/Update/Delete/Search Student\nDatabase --&gt; System : Student Data Updated\n\nSystem --&gt; Admin : Confirmation\n\ndeactivate System\n\n== Teacher Management ==\n\nAdmin -&gt; System : Manage Teacher Records\n\nactivate System\n\nSystem -&gt; Database : Add/Update/Delete Teacher\nSystem -&gt; Database : Assign Subjects\nSystem -&gt; Database : Manage Payments\n\nDatabase --&gt; System : Teacher Data Updated\n\nSystem --&gt; Admin : Confirmation\n\ndeactivate System\n\n== Attendance Management ==\n\nStudent -&gt; System : Scan QR Attendance\n\nactivate System\n\nSystem -&gt; QR : Validate QR\n\nQR --&gt; System : Validation Result\n\nalt QR Valid\n\nSystem -&gt; Database : Record Attendance\n\nSystem --&gt; Parent : Send Attendance Notification\n\nelse Invalid QR\n\nSystem --&gt; Student : Invalid QR Message\n\nend\n\nSystem --&gt; Admin : Attendance Report\n\ndeactivate System\n\n== Notification Management ==\n\nAdmin -&gt; System : Manage Notifications\n\nactivate System\n\nSystem --&gt; Parent : Payment Notification\n\nSystem --&gt; Parent : Overdue Reminder\n\nSystem --&gt; Parent : Meeting Notice\n\nSystem --&gt; Parent : General Announcement\n\ndeactivate System\n\n== Assignment Management ==\n\nTeacher -&gt; System : Upload Assignment\n\nactivate System\n\nSystem -&gt; Database : Store Assignment\n\nStudent -&gt; System : View Assignment\n\nStudent -&gt; System : Submit Assignment\n\nSystem -&gt; Database : Save Submission\n\nTeacher -&gt; System : Review Submission\n\ndeactivate System\n\n== Marks Management ==\n\nTeacher -&gt; System : Upload Marks\n\nactivate System\n\nSystem -&gt; Database : Store Marks\n\nStudent -&gt; System : View Marks\n\nParent -&gt; System : View Student Marks\n\nSystem -&gt; Database : Retrieve Marks\n\nDatabase --&gt; System : Marks Data\n\ndeactivate System\n\n== AI Learning Support ==\n\nAdmin -&gt; System : Upload Learning Resources\n\nStudent -&gt; System : Access AI Chatbot\n\nactivate System\n\nStudent -&gt; System : Ask Question\n\nSystem -&gt; AI : Retrieve Content\n\nAI --&gt; System : AI Response\n\nSystem --&gt; Student : Display Answer\n\ndeactivate System\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="KBaCtSJ0cGqb0dNJpNkf-1">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="1669" width="942" x="20" y="20" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
