<mxfile host="app.diagrams.net" pages="8">
  <diagram id="A75FrDwb7kf2IlMNNH53" name="Manage Student Records">
    <mxGraphModel dx="1801" dy="-3546" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle SD-01 Manage Student Records\n\nactor Admin\n\nboundary \&quot;Student Management UI\&quot; as UI\ncontrol \&quot;Student Management Service\&quot; as SMS\ndatabase \&quot;Database\&quot; as DB\n\nAdmin -&gt; UI : Access Student Management Module\n\nUI -&gt; SMS : Request Student Management Options\nSMS --&gt; UI : Display Available Operations\n\nAdmin -&gt; UI : Select Operation\\n(Add/Update/Delete/Search/\\nView Attendance/View Payment)\n\nUI -&gt; SMS : Submit Selected Operation\n\nSMS -&gt; UI : Request Required Information\n\nAdmin -&gt; UI : Enter Information\n\nUI -&gt; SMS : Send Data For Validation\n\nSMS -&gt; SMS : Validate Input Data\n\nalt Invalid Information\n    SMS --&gt; UI : Display Validation Error\n    UI --&gt; Admin : Request Correction\n\nelse Valid Information\n\n    SMS -&gt; DB : Retrieve/Update Records\n\n    alt Database Failure\n        DB --&gt; SMS : Operation Failed\n        SMS --&gt; UI : Display Failure Message\n        UI --&gt; Admin : Notify Failure\n\n    else Success\n        DB --&gt; SMS : Operation Successful\n        SMS --&gt; UI : Display Result\n        UI --&gt; Admin : Show Confirmation\n    end\n\nend\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="KxOZXuAkYJrkYG57w5Ow-1">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="846" width="759" x="20" y="4960" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="3qJFmncB6O4eYgKZpiQZ" name="Manage Teacher Records">
    <mxGraphModel dx="1261" dy="598" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle SD-02 Manage Teacher Records\n\nactor Admin\n\nboundary \&quot;Teacher Management UI\&quot; as UI\ncontrol \&quot;Teacher Management Service\&quot; as TMS\ndatabase \&quot;Database\&quot; as DB\n\nAdmin -&gt; UI : Access Teacher Management Module\n\nUI -&gt; TMS : Request Teacher Management Options\nTMS --&gt; UI : Display Available Operations\n\nAdmin -&gt; UI : Select Operation\\n(Add/Update/Delete/\\nAssign Subjects/View Details/\\nManage Payments)\n\nUI -&gt; TMS : Submit Selected Operation\n\nTMS -&gt; UI : Request Required Information\n\nAdmin -&gt; UI : Enter Information\n\nUI -&gt; TMS : Send Data For Validation\n\nTMS -&gt; TMS : Validate Input Data\n\nalt Invalid Information\n    TMS --&gt; UI : Display Validation Error\n    UI --&gt; Admin : Request Correction\n\nelse Valid Information\n\n    TMS -&gt; DB : Retrieve/Update Records\n\n    alt Database Failure\n        DB --&gt; TMS : Operation Failed\n        TMS --&gt; UI : Display Failure Message\n        UI --&gt; Admin : Notify Failure\n\n    else Success\n        DB --&gt; TMS : Operation Successful\n        TMS --&gt; UI : Display Result\n        UI --&gt; Admin : Show Confirmation\n    end\n\nend\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="5_cf2fQ1yboPwrw9aRqw-1">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="860" width="759" x="20" y="20" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="UBTag_PqcgdMYNbKU0Pl" name="QR_Attendance_Process">
    <mxGraphModel dx="1261" dy="598" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle SD-03 QR Attendance Process\n\nactor Student\nactor Parent\n\nboundary \&quot;Student Mobile App\&quot; as App\ncontrol \&quot;QR Attendance Service\&quot; as QR\ndatabase \&quot;Database\&quot; as DB\ncontrol \&quot;Notification Service\&quot; as NS\n\nStudent -&gt; App : Open QR Scanner\n\nApp --&gt; Student : Display Scanner\n\nStudent -&gt; App : Scan QR Code\n\nApp -&gt; QR : Send QR Data\n\nQR -&gt; QR : Validate QR\n\nalt Invalid QR\n    QR --&gt; App : Invalid QR Notification\n    App --&gt; Student : Display Error\n\nelse Expired QR\n    QR --&gt; App : QR Expired\n    App --&gt; Student : Display Expired Message\n\nelse Valid QR\n\n    QR -&gt; DB : Retrieve Student Information\n    DB --&gt; QR : Student Data\n\n    QR -&gt; DB : Record Attendance\n    DB --&gt; QR : Attendance Saved\n\n    QR -&gt; NS : Trigger Parent Notification\n\n    NS -&gt; DB : Retrieve Parent Contact\n    DB --&gt; NS : Parent Details\n\n    NS -&gt; Parent : Attendance Notification\n\n    NS --&gt; QR : Notification Sent\n\n    QR --&gt; App : Attendance Success\n    App --&gt; Student : Display Confirmation\n\nend\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="5ZBd7C3IC4Og7rVvMUAC-1">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="844" width="864" x="20" y="20" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="JvlmivzRsAL2T4g2CCX7" name="Generate_Attendance_Report">
    <mxGraphModel dx="1261" dy="598" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle SD-04 Generate Attendance Report\n\nactor Admin\n\nboundary \&quot;Attendance Report UI\&quot; as UI\ncontrol \&quot;Attendance Report Service\&quot; as ARS\ndatabase \&quot;Database\&quot; as DB\n\nAdmin -&gt; UI : Select Attendance Report\n\nUI -&gt; ARS : Request Report Generation\n\nARS -&gt; UI : Request Report Criteria\n\nAdmin -&gt; UI : Enter Criteria\n\nUI -&gt; ARS : Submit Criteria\n\nARS -&gt; ARS : Validate Criteria\n\nalt Invalid Criteria\n    ARS --&gt; UI : Validation Error\n    UI --&gt; Admin : Request Correction\n\nelse Valid Criteria\n\n    ARS -&gt; DB : Retrieve Attendance Records\n\n    alt Records Not Found\n        DB --&gt; ARS : No Records Available\n        ARS --&gt; UI : Display No Data Message\n\n    else Records Found\n        DB --&gt; ARS : Attendance Records\n        ARS -&gt; ARS : Generate Report\n        ARS --&gt; UI : Display Report\n        UI --&gt; Admin : View Report\n    end\n\nend\n\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="mTvn8nQr8DDa9aQI-Bne-1">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="747" width="674" x="20" y="20" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="lFq8bRyM-eh7h0tO0ZGP" name="Manage_Notifications">
    <mxGraphModel dx="1261" dy="598" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle SD-05 Manage Notifications\n\nactor Admin\nactor Parent\n\nboundary \&quot;Notification Management UI\&quot; as UI\ncontrol \&quot;Notification Service\&quot; as NS\ndatabase \&quot;Database\&quot; as DB\n\nAdmin -&gt; UI : Access Notification Module\n\nUI -&gt; NS : Request Notification Options\n\nNS --&gt; UI : Display Notification Types\n\nAdmin -&gt; UI : Select Notification Type\n\nUI -&gt; NS : Submit Notification Request\n\nNS -&gt; UI : Request Notification Details\n\nAdmin -&gt; UI : Enter Details\n\nUI -&gt; NS : Send Notification Data\n\nNS -&gt; NS : Validate Information\n\nalt Invalid Information\n    NS --&gt; UI : Validation Error\n    UI --&gt; Admin : Request Correction\n\nelse Valid Information\n\n    NS -&gt; DB : Retrieve Recipient Details\n    DB --&gt; NS : Recipient Information\n\n    NS -&gt; Parent : Send Notification\n\n    alt Delivery Failure\n        NS --&gt; UI : Delivery Failed\n        UI --&gt; Admin : Display Failure\n\n    else Delivered\n        NS --&gt; UI : Delivery Success\n        UI --&gt; Admin : Display Confirmation\n    end\n\nend\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="Zzqn0k6Okv0rFu855BMl-1">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="818" width="690" x="20" y="20" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="cE4bsbr-BKfa1dlzDAY3" name="Assignment_Management">
    <mxGraphModel dx="1261" dy="598" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle SD-06 Assignment Management\n\nactor Teacher\nactor Student\n\nboundary \&quot;Assignment Module\&quot; as AM\ncontrol \&quot;Assignment Service\&quot; as AS\ndatabase \&quot;Database\&quot; as DB\n\nTeacher -&gt; AM : Upload Assignment\n\nAM -&gt; AS : Submit Assignment\n\nAS -&gt; AS : Validate Assignment\n\nalt Invalid Assignment\n    AS --&gt; AM : Validation Error\n    AM --&gt; Teacher : Display Error\n\nelse Valid Assignment\n\n    AS -&gt; DB : Store Assignment\n    DB --&gt; AS : Assignment Saved\n\n    AS --&gt; AM : Publish Assignment\n\n    Student -&gt; AM : View Assignment\n\n    AM -&gt; AS : Request Assignment\n\n    AS -&gt; DB : Retrieve Assignment\n    DB --&gt; AS : Assignment Details\n\n    AS --&gt; AM : Display Assignment\n\n    Student -&gt; AM : Submit Assignment\n\n    AM -&gt; AS : Upload Submission\n\n    AS -&gt; DB : Store Submission\n    DB --&gt; AS : Submission Saved\n\n    Teacher -&gt; AM : Review Submission\n\n    AM -&gt; AS : Retrieve Submission\n\n    AS -&gt; DB : Fetch Submission\n    DB --&gt; AS : Submission Data\n\n    AS --&gt; Teacher : Display Submission\n\nend\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="Hse00F44Wz-prWmmy4-g-1">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="886" width="590" x="20" y="20" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="6afJ-L-h7qZvZjj9WsVC" name="Marks_Management">
    <mxGraphModel dx="1261" dy="598" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle SD-07 Marks Management\n\nactor Teacher\nactor Student\nactor Parent\n\nboundary \&quot;Marks Module\&quot; as MM\ncontrol \&quot;Marks Service\&quot; as MS\ndatabase \&quot;Database\&quot; as DB\n\nTeacher -&gt; MM : Upload Marks\n\nMM -&gt; MS : Submit Marks\n\nMS -&gt; MS : Validate Marks\n\nalt Invalid Marks\n    MS --&gt; MM : Validation Error\n    MM --&gt; Teacher : Display Error\n\nelse Valid Marks\n\n    MS -&gt; DB : Store Marks\n    DB --&gt; MS : Marks Saved\n\n    MS --&gt; MM : Upload Success\n\n    Student -&gt; MM : View Marks\n\n    MM -&gt; MS : Request Marks\n\n    MS -&gt; DB : Retrieve Marks\n    DB --&gt; MS : Marks Information\n\n    MS --&gt; MM : Display Marks\n\n    Parent -&gt; MM : View Child Marks\n\n    MM -&gt; MS : Request Child Marks\n\n    MS -&gt; DB : Retrieve Child Marks\n    DB --&gt; MS : Marks Information\n\n    MS --&gt; MM : Display Marks\n\nend\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="xcmYksXNk9aDSsaFPbCU-1">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="774" width="651" x="20" y="20" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="uByg4pgLIShUPCppiI-H" name="AI_Learning_Support_Process">
    <mxGraphModel dx="1261" dy="598" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle SD-08 AI Learning Support Process\n\nactor Student\n\nboundary \&quot;AI Chatbot UI\&quot; as UI\ncontrol \&quot;AI Chatbot Service\&quot; as AI\ndatabase \&quot;Learning Resource Database\&quot; as LRD\n\nStudent -&gt; UI : Access AI Chatbot\n\nUI -&gt; AI : Initialize Session\n\nAI --&gt; UI : Chatbot Ready\n\nStudent -&gt; UI : Submit Question\n\nUI -&gt; AI : Forward Question\n\nAI -&gt; AI : Analyze Question\n\nAI -&gt; LRD : Search Relevant Resources\n\nalt No Relevant Content\n    LRD --&gt; AI : No Content Found\n    AI --&gt; UI : Content Unavailable\n\nelse Content Found\n\n    LRD --&gt; AI : Relevant Resources\n\n    AI -&gt; AI : Generate Response\n\n    alt Response Generation Failed\n        AI --&gt; UI : Generation Error\n\n    else Response Generated\n        AI --&gt; UI : AI Answer\n        UI --&gt; Student : Display Answer\n    end\n\nend\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="Wicayh6wMF9UwPxm8nYd-1">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="719" width="637" x="20" y="20" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
