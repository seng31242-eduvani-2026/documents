  <diagram name="Page-1" id="s-BIQoaQIT_suytayJdA">
    <mxGraphModel dx="1022" dy="626" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Vani Tuition Centre Management System - Class Diagram\n\nskinparam classAttributeIconSize 0\n\n&#39;========================\n&#39; USER HIERARCHY\n&#39;========================\n\nabstract class User {\n    +userId : String\n    +name : String\n    +email : String\n    +phoneNumber : String\n    +username : String\n    +password : String\n    +login()\n    +logout()\n}\n\nclass Admin {\n    +manageStudents()\n    +manageTeachers()\n    +manageNotifications()\n    +generateReports()\n    +uploadLearningResources()\n}\n\nclass Teacher {\n    +uploadAssignment()\n    +reviewSubmission()\n    +uploadMarks()\n}\n\nclass Student {\n    +scanQR()\n    +viewAssignments()\n    +submitAssignment()\n    +viewMarks()\n    +askQuestion()\n}\n\nclass Parent {\n    +viewMarks()\n    +receiveNotification()\n}\n\nUser &lt;|-- Admin\nUser &lt;|-- Teacher\nUser &lt;|-- Student\nUser &lt;|-- Parent\n\n&#39;========================\n&#39; STUDENT MANAGEMENT\n&#39;========================\n\nclass Attendance {\n    +attendanceId : String\n    +date : Date\n    +time : Time\n    +status : String\n    +recordAttendance()\n}\n\nclass AttendanceSession {\n    +sessionId : String\n    +qrCode : String\n    +expiryTime : DateTime\n    +validateQR()\n}\n\nStudent \&quot;1\&quot; -- \&quot;0..*\&quot; Attendance\nAttendanceSession \&quot;1\&quot; -- \&quot;0..*\&quot; Attendance\n\n&#39;========================\n&#39; PAYMENTS\n&#39;========================\n\nclass Payment {\n    +paymentId : String\n    +amount : Double\n    +paymentDate : Date\n    +status : String\n    +updateStatus()\n}\n\nStudent \&quot;1\&quot; -- \&quot;0..*\&quot; Payment\n\n&#39;========================\n&#39; SUBJECTS\n&#39;========================\n\nclass Subject {\n    +subjectId : String\n    +subjectName : String\n    +description : String\n}\n\nTeacher \&quot;*\&quot; -- \&quot;*\&quot; Subject\n\n&#39;========================\n&#39; ASSIGNMENTS\n&#39;========================\n\nclass Assignment {\n    +assignmentId : String\n    +title : String\n    +description : String\n    +deadline : Date\n    +publish()\n}\n\nclass Submission {\n    +submissionId : String\n    +submissionDate : Date\n    +filePath : String\n    +status : String\n}\n\nTeacher \&quot;1\&quot; -- \&quot;0..*\&quot; Assignment\nAssignment \&quot;1\&quot; -- \&quot;0..*\&quot; Submission\nStudent \&quot;1\&quot; -- \&quot;0..*\&quot; Submission\n\n&#39;========================\n&#39; MARKS\n&#39;========================\n\nclass Mark {\n    +markId : String\n    +score : Double\n    +assessmentName : String\n    +storeMarks()\n}\n\nStudent \&quot;1\&quot; -- \&quot;0..*\&quot; Mark\nTeacher \&quot;1\&quot; -- \&quot;0..*\&quot; Mark\n\n&#39;========================\n&#39; NOTIFICATIONS\n&#39;========================\n\nclass Notification {\n    +notificationId : String\n    +title : String\n    +message : String\n    +dateCreated : Date\n    +send()\n}\n\nAdmin \&quot;1\&quot; -- \&quot;0..*\&quot; Notification\nParent \&quot;1\&quot; -- \&quot;0..*\&quot; Notification\n\n&#39;========================\n&#39; AI LEARNING SUPPORT\n&#39;========================\n\nclass LearningResource {\n    +resourceId : String\n    +title : String\n    +fileType : String\n    +uploadResource()\n}\n\nclass ChatSession {\n    +sessionId : String\n    +startTime : DateTime\n    +endTime : DateTime\n}\n\nclass ChatMessage {\n    +messageId : String\n    +question : String\n    +response : String\n}\n\nAdmin \&quot;1\&quot; -- \&quot;0..*\&quot; LearningResource\n\nStudent \&quot;1\&quot; -- \&quot;0..*\&quot; ChatSession\nChatSession \&quot;1\&quot; -- \&quot;0..*\&quot; ChatMessage\n\nLearningResource .. ChatMessage : provides content\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="pnmUDsnanhA6ZSEl1Lgx-1">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="768" width="1638" x="20" y="20" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nhide circle\nskinparam linetype ortho\n\nentity users {\n    * user_id : BIGINT &lt;&lt;PK&gt;&gt;\n    --\n    username : VARCHAR\n    password : VARCHAR\n    role : VARCHAR\n    email : VARCHAR\n    phone : VARCHAR\n    status : VARCHAR\n    created_at : DATETIME\n}\n\nentity students {\n    * student_id : BIGINT &lt;&lt;PK&gt;&gt;\n    --\n    user_id : BIGINT &lt;&lt;FK&gt;&gt;\n    full_name : VARCHAR\n    date_of_birth : DATE\n    address : TEXT\n    parent_name : VARCHAR\n    parent_phone : VARCHAR\n    parent_email : VARCHAR\n    registration_date : DATE\n    status : VARCHAR\n}\n\nentity teachers {\n    * teacher_id : BIGINT &lt;&lt;PK&gt;&gt;\n    --\n    user_id : BIGINT &lt;&lt;FK&gt;&gt;\n    full_name : VARCHAR\n    qualification : VARCHAR\n    salary : DECIMAL\n    joining_date : DATE\n    status : VARCHAR\n}\n\nentity subjects {\n    * subject_id : BIGINT &lt;&lt;PK&gt;&gt;\n    --\n    subject_name : VARCHAR\n    description : TEXT\n}\n\nentity teacher_subjects {\n    * id : BIGINT &lt;&lt;PK&gt;&gt;\n    --\n    teacher_id : BIGINT &lt;&lt;FK&gt;&gt;\n    subject_id : BIGINT &lt;&lt;FK&gt;&gt;\n}\n\nentity attendance_sessions {\n    * session_id : BIGINT &lt;&lt;PK&gt;&gt;\n    --\n    subject_id : BIGINT &lt;&lt;FK&gt;&gt;\n    qr_code : VARCHAR\n    generated_time : DATETIME\n    expiry_time : DATETIME\n    status : VARCHAR\n}\n\nentity attendance {\n    * attendance_id : BIGINT &lt;&lt;PK&gt;&gt;\n    --\n    student_id : BIGINT &lt;&lt;FK&gt;&gt;\n    session_id : BIGINT &lt;&lt;FK&gt;&gt;\n    attendance_date : DATE\n    attendance_time : TIME\n    status : VARCHAR\n}\n\nentity student_payments {\n    * payment_id : BIGINT &lt;&lt;PK&gt;&gt;\n    --\n    student_id : BIGINT &lt;&lt;FK&gt;&gt;\n    amount : DECIMAL\n    payment_date : DATE\n    payment_month : VARCHAR\n    status : VARCHAR\n}\n\nentity teacher_payments {\n    * payment_id : BIGINT &lt;&lt;PK&gt;&gt;\n    --\n    teacher_id : BIGINT &lt;&lt;FK&gt;&gt;\n    amount : DECIMAL\n    payment_date : DATE\n    status : VARCHAR\n}\n\nentity assignments {\n    * assignment_id : BIGINT &lt;&lt;PK&gt;&gt;\n    --\n    teacher_id : BIGINT &lt;&lt;FK&gt;&gt;\n    subject_id : BIGINT &lt;&lt;FK&gt;&gt;\n    title : VARCHAR\n    description : TEXT\n    file_path : VARCHAR\n    deadline : DATETIME\n    created_at : DATETIME\n}\n\nentity assignment_submissions {\n    * submission_id : BIGINT &lt;&lt;PK&gt;&gt;\n    --\n    assignment_id : BIGINT &lt;&lt;FK&gt;&gt;\n    student_id : BIGINT &lt;&lt;FK&gt;&gt;\n    file_path : VARCHAR\n    submitted_at : DATETIME\n    status : VARCHAR\n    feedback : TEXT\n}\n\nentity marks {\n    * mark_id : BIGINT &lt;&lt;PK&gt;&gt;\n    --\n    student_id : BIGINT &lt;&lt;FK&gt;&gt;\n    subject_id : BIGINT &lt;&lt;FK&gt;&gt;\n    teacher_id : BIGINT &lt;&lt;FK&gt;&gt;\n    assessment_name : VARCHAR\n    score : DECIMAL\n    uploaded_at : DATETIME\n}\n\nentity notifications {\n    * notification_id : BIGINT &lt;&lt;PK&gt;&gt;\n    --\n    title : VARCHAR\n    message : TEXT\n    type : VARCHAR\n    created_by : BIGINT &lt;&lt;FK&gt;&gt;\n    created_at : DATETIME\n}\n\nentity notification_recipients {\n    * id : BIGINT &lt;&lt;PK&gt;&gt;\n    --\n    notification_id : BIGINT &lt;&lt;FK&gt;&gt;\n    student_id : BIGINT &lt;&lt;FK&gt;&gt;\n    recipient_phone : VARCHAR\n    recipient_email : VARCHAR\n    delivery_status : VARCHAR\n    sent_at : DATETIME\n}\n\nentity learning_resources {\n    * resource_id : BIGINT &lt;&lt;PK&gt;&gt;\n    --\n    title : VARCHAR\n    description : TEXT\n    file_path : VARCHAR\n    uploaded_by : BIGINT &lt;&lt;FK&gt;&gt;\n    uploaded_at : DATETIME\n}\n\nentity chat_sessions {\n    * session_id : BIGINT &lt;&lt;PK&gt;&gt;\n    --\n    student_id : BIGINT &lt;&lt;FK&gt;&gt;\n    started_at : DATETIME\n    ended_at : DATETIME\n}\n\nentity chat_messages {\n    * message_id : BIGINT &lt;&lt;PK&gt;&gt;\n    --\n    session_id : BIGINT &lt;&lt;FK&gt;&gt;\n    question : TEXT\n    response : TEXT\n    created_at : DATETIME\n}\n\n&#39;====================\n&#39; RELATIONSHIPS\n&#39;====================\n\nusers ||--|| students\nusers ||--|| teachers\n\nteachers ||--o{ teacher_subjects\nsubjects ||--o{ teacher_subjects\n\nsubjects ||--o{ attendance_sessions\n\nstudents ||--o{ attendance\nattendance_sessions ||--o{ attendance\n\nstudents ||--o{ student_payments\nteachers ||--o{ teacher_payments\n\nteachers ||--o{ assignments\nsubjects ||--o{ assignments\n\nassignments ||--o{ assignment_submissions\nstudents ||--o{ assignment_submissions\n\nstudents ||--o{ marks\nteachers ||--o{ marks\nsubjects ||--o{ marks\n\nusers ||--o{ notifications : creates\n\nnotifications ||--o{ notification_recipients\nstudents ||--o{ notification_recipients\n\nusers ||--o{ learning_resources : uploads\n\nstudents ||--o{ chat_sessions\nchat_sessions ||--o{ chat_messages\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="pnmUDsnanhA6ZSEl1Lgx-2">
